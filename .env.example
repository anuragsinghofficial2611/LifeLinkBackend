# Server Configuration
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/lifelink

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_lifelink_backend_2025_at_least_32_chars
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (seeded automatically on startup if admin does not exist)
DEFAULT_ADMIN_NAME=Super Admin
DEFAULT_ADMIN_EMAIL=admin@lifelink.org
DEFAULT_ADMIN_PASSWORD=Admin@SecurePass123!

# External AI Service (Optional for AI Chatbot)
GEMINI_API_KEY=
OPENAI_API_KEY=
